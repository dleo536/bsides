REACT_NATIVE_API_TARGET=local

# Local backend for simulator/emulator development.
# For a physical device, replace localhost with your machine's LAN IP.
REACT_NATIVE_LOCAL_API_URL=http://localhost:3000

# Hosted backend for testing the real Cloud Run service from your local app.
REACT_NATIVE_STAGING_API_URL=https://b-backend-50184648070.us-central1.run.app

# Set this later when you have a separate production API hostname.
REACT_NATIVE_PRODUCTION_API_URL=https://b-backend-50184648070.us-central1.run.app

# Optional one-off override. If set, this wins over the target-based settings.
# REACT_NATIVE_API_URL=
